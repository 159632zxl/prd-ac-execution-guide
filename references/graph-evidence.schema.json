{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/159632zxl/prd-ac-execution-guide/schema/graph-evidence-1.0.json",
  "title": "PRD code graph evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "graph_type",
    "repository",
    "provider",
    "coverage",
    "source_coverage",
    "nodes",
    "edges",
    "contracts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"enum": ["graph_snapshot", "graph_diff"]},
    "graph_type": {"enum": ["observed", "target", "change"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "git_sha"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/gitSha"}
      }
    },
    "provider": {"$ref": "#/$defs/provider"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "paths", "excluded_paths"],
      "properties": {
        "scope": {"enum": ["local", "module", "repository", "system"]},
        "status": {"enum": ["complete", "partial", "unknown"]},
        "paths": {"type": "array", "items": {"type": "string"}},
        "excluded_paths": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceCoverage"}
    },
    "baseline_sha": {"$ref": "#/$defs/gitSha"},
    "current_sha": {"$ref": "#/$defs/gitSha"},
    "diff": {"$ref": "#/$defs/diff"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}},
    "review_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewFinding"}
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command", "generated_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_section_id", "status", "requirement_refs", "ac_refs"],
      "properties": {
        "source_section_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["covered", "deferred", "not-applicable"]},
        "requirement_refs": {"type": "array", "items": {"type": "string"}},
        "ac_refs": {"type": "array", "items": {"type": "string"}},
        "explicit_reason": {"type": "string"},
        "source_anchor": {"$ref": "#/$defs/sourceAnchor"}
      }
    },
    "sourceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "status",
        "path",
        "qualified_symbol",
        "provider",
        "git_sha",
        "confidence",
        "coverage",
        "freshness",
        "verification_evidence",
        "requirement_refs"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "path": {"type": "string", "minLength": 1},
        "qualified_symbol": {"type": "string", "minLength": 1},
        "source_anchor": {
          "anyOf": [{"$ref": "#/$defs/sourceAnchor"}, {"type": "null"}]
        },
        "provider": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"$ref": "#/$defs/coverageStatus"},
        "freshness": {"enum": ["current", "stale", "unknown"]},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "requirement_refs": {"type": "array", "items": {"type": "string"}},
        "entrypoint": {"type": "boolean"},
        "test_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "kind",
        "from",
        "to",
        "status",
        "provider",
        "git_sha",
        "source_anchor",
        "confidence",
        "coverage",
        "freshness",
        "verification_evidence",
        "requirement_refs"
      ],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "calls",
            "imports",
            "reads",
            "writes",
            "publishes",
            "subscribes",
            "validates",
            "routes",
            "returns",
            "dynamic"
          ]
        },
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "provider": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "source_anchor": {
          "anyOf": [{"$ref": "#/$defs/sourceAnchor"}, {"type": "null"}]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"$ref": "#/$defs/coverageStatus"},
        "freshness": {"enum": ["current", "stale", "unknown"]},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "requirement_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "storage_node_id",
        "writers",
        "readers",
        "state_values",
        "state_semantics",
        "state_producers",
        "state_consumers",
        "enum_values",
        "schema_enum_values",
        "expected_runtime_state",
        "runtime_evidence",
        "status",
        "verification_evidence"
      ],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "storage_node_id": {"type": "string", "minLength": 1},
        "writers": {"type": "array", "items": {"type": "string"}},
        "readers": {"type": "array", "items": {"type": "string"}},
        "writer_milestone": {"type": "string"},
        "reader_milestone": {"type": "string"},
        "state_values": {"type": "array", "items": {"type": "string"}},
        "state_semantics": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "state_producers": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "state_consumers": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "terminal_states": {"type": "array", "items": {"type": "string"}},
        "enum_values": {"type": "array", "items": {"type": "string"}},
        "schema_enum_values": {"type": "array", "items": {"type": "string"}},
        "expected_runtime_state": {
          "enum": ["non-empty", "intentionally empty", "not applicable"]
        },
        "intentional_empty_reason": {"type": "string"},
        "intentional_empty_milestone": {"type": "string"},
        "runtime_evidence": {"$ref": "#/$defs/evidence"},
        "status": {"$ref": "#/$defs/status"},
        "verification_evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "evidence"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "verified", "rejected", "inconclusive"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "independent_verification": {"$ref": "#/$defs/evidence"}
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added_nodes",
        "removed_nodes",
        "changed_nodes",
        "added_edges",
        "removed_edges",
        "changed_edges",
        "unresolved",
        "impact",
        "verification_evidence"
      ],
      "properties": {
        "added_nodes": {"type": "array", "items": {"type": "string"}},
        "removed_nodes": {"type": "array", "items": {"type": "string"}},
        "changed_nodes": {"type": "array", "items": {"type": "string"}},
        "added_edges": {"type": "array", "items": {"type": "string"}},
        "removed_edges": {"type": "array", "items": {"type": "string"}},
        "changed_edges": {"type": "array", "items": {"type": "string"}},
        "unresolved": {"type": "array", "items": {"type": "string"}},
        "impact": {"type": "array", "items": {"type": "string"}},
        "verification_evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "status": {
      "enum": [
        "planned",
        "observed",
        "changed",
        "implemented",
        "verified",
        "blocked",
        "unresolved",
        "removed"
      ]
    },
    "coverageStatus": {"enum": ["complete", "partial", "unknown"]}
  },
  "allOf": [
    {
      "if": {
        "required": ["graph_type"],
        "properties": {"graph_type": {"const": "change"}}
      },
      "then": {
        "required": ["baseline_sha", "current_sha", "diff"],
        "properties": {
          "artifact_type": {"const": "graph_diff"},
          "diff": {"$ref": "#/$defs/diff"}
        }
      },
      "else": {"properties": {"artifact_type": {"const": "graph_snapshot"}}}
    }
  ]
}
