{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/159632zxl/prd-ac-execution-guide/schema/graph-evidence-1.1.json",
  "$comment": "This schema enforces JSON shape and machine-expressible conditions. Run scripts/check_graph_evidence.py for cross-reference integrity, SHA equality, source-anchor ordering and node-path equality, placeholder evidence, and other semantic cross-field gates.",
  "title": "PRD code graph evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "graph_type",
    "repository",
    "provider",
    "coverage",
    "source_coverage",
    "audit_coverage",
    "nodes",
    "edges",
    "contracts",
    "test_chains"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "artifact_type": {"enum": ["graph_snapshot", "graph_diff"]},
    "graph_type": {"enum": ["observed", "target", "change"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "git_sha"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/gitSha"}
      }
    },
    "provider": {"$ref": "#/$defs/provider"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "paths", "excluded_paths"],
      "properties": {
        "scope": {"enum": ["local", "module", "repository", "system"]},
        "status": {"enum": ["complete", "partial", "unknown"]},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excluded_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["partial", "unknown"]}}},
          "then": {
            "required": ["limitations"],
            "properties": {"limitations": {"minItems": 1}}
          }
        }
      ]
    },
    "source_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceCoverage"}
    },
    "audit_coverage": {"$ref": "#/$defs/auditCoverage"},
    "baseline_sha": {"$ref": "#/$defs/gitSha"},
    "current_sha": {"$ref": "#/$defs/gitSha"},
    "diff": {"$ref": "#/$defs/diff"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/edge"}},
    "contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contract"}},
    "test_chains": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/testChain"}},
    "review_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewFinding"}
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
    },
    "strategyParameterObject": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/strategyParameterValue"}
    },
    "strategyParameterArray": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/strategyParameterValue"}
    },
    "strategyParameterValue": {
      "oneOf": [
        {"$ref": "#/$defs/strategyParameterObject"},
        {"$ref": "#/$defs/strategyParameterArray"},
        {"type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
        {"type": "number"},
        {"type": "boolean"}
      ]
    },
    "strategyParameters": {
      "oneOf": [
        {"$ref": "#/$defs/strategyParameterObject"},
        {"$ref": "#/$defs/strategyParameterArray"},
        {"type": "string", "minLength": 1, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
        {"type": "number"}
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command", "generated_at", "capabilities", "limitations"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "generated_at": {
          "type": "string",
          "minLength": 1,
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_section_id",
        "status",
        "requirement_refs",
        "ears_refs",
        "target_node_refs",
        "target_edge_refs",
        "ac_refs",
        "owner_task",
        "source_anchor"
      ],
      "properties": {
        "source_section_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["covered", "deferred", "not-applicable"]},
        "requirement_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "ears_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "target_node_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "target_edge_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "ac_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "owner_task": {"type": "string", "minLength": 1},
        "explicit_reason": {"type": "string"},
        "source_anchor": {
          "anyOf": [{"$ref": "#/$defs/sourceAnchor"}, {"type": "null"}]
        }
      },
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "covered"}}},
          "then": {
            "properties": {
              "requirement_refs": {"minItems": 1},
              "ears_refs": {"minItems": 1},
              "target_node_refs": {"minItems": 1},
              "target_edge_refs": {"minItems": 1},
              "ac_refs": {"minItems": 1},
              "owner_task": {"minLength": 1},
              "source_anchor": {"$ref": "#/$defs/sourceAnchor"}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["deferred", "not-applicable"]}}},
          "then": {
            "required": ["explicit_reason"],
            "properties": {"explicit_reason": {"minLength": 1}}
          }
        }
      ]
    },
    "auditCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewers", "independent_verification", "limitations"],
      "properties": {
        "status": {"enum": ["complete", "partial", "inconclusive"]},
        "reviewers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "independent_verification": {"$ref": "#/$defs/evidence"},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "complete"}}},
          "then": {
            "properties": {
              "reviewers": {"minItems": 1},
              "independent_verification": {"minItems": 1}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["partial", "inconclusive"]}}},
          "then": {"properties": {"limitations": {"minItems": 1}}}
        }
      ]
    },
    "sourceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "pattern": "^\\S(?:[\\s\\S]*\\S)?$",
        "not": {
          "pattern": "^(?:[Nn][Oo] (?:(?:independent|runtime|static|test) )?(?:evidence|verification|tests?|testing|results?)|(?:[Nn]ot|[Nn]ever) (?:run|executed|tested|verified|checked|performed)|(?:[Ww]ithout|[Mm]issing) (?:(?:independent|runtime|static|test) )?(?:evidence|verification|results?)|(?:无|没有|暂无)(?:独立|运行时|静态|测试)?(?:证据|验证|测试|结果)|(?:未|尚未)(?:运行|执行|测试|验证|检查))(?: yet)?[.!?。！？]*$"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "status",
        "path",
        "qualified_symbol",
        "provider",
        "git_sha",
        "confidence",
        "coverage",
        "freshness",
        "verification_evidence",
        "requirement_refs"
      ],
      "properties": {
        "node_id": {"$ref": "#/$defs/identifier"},
        "kind": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "path": {"type": "string", "minLength": 1},
        "qualified_symbol": {"type": "string", "minLength": 1},
        "source_anchor": {
          "anyOf": [{"$ref": "#/$defs/sourceAnchor"}, {"type": "null"}]
        },
        "provider": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"$ref": "#/$defs/coverageStatus"},
        "freshness": {"enum": ["current", "stale", "unknown"]},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "requirement_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "entrypoint": {"type": "boolean"},
        "test_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "test_exemption_reason": {"type": "string", "minLength": 1},
        "blocked_reason": {"type": "string", "minLength": 1},
        "unresolved_reason": {"type": "string", "minLength": 1},
        "next_query": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "verified"}}},
          "then": {"properties": {"verification_evidence": {"minItems": 1}}}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["observed", "implemented"]}}},
          "then": {"properties": {"verification_evidence": {"minItems": 1}}}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["observed", "changed", "implemented"]}}},
          "then": {"properties": {"verification_evidence": {"minItems": 1}}}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["observed", "changed", "implemented", "verified"]}}},
          "then": {
            "required": ["source_anchor"],
            "properties": {"source_anchor": {"$ref": "#/$defs/sourceAnchor"}}
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["changed", "implemented", "verified"]}}},
          "then": {
            "anyOf": [
              {"required": ["test_refs"], "properties": {"test_refs": {"minItems": 1}}},
              {"required": ["test_exemption_reason"]}
            ]
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "blocked"}}},
          "then": {"required": ["blocked_reason", "next_query"]}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "unresolved"}}},
          "then": {"required": ["unresolved_reason", "next_query"]}
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "kind",
        "from",
        "to",
        "status",
        "provider",
        "git_sha",
        "source_anchor",
        "confidence",
        "coverage",
        "freshness",
        "verification_evidence",
        "requirement_refs"
      ],
      "properties": {
        "edge_id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": [
            "calls",
            "imports",
            "reads",
            "writes",
            "publishes",
            "subscribes",
            "validates",
            "routes",
            "returns",
            "dynamic"
          ]
        },
        "from": {"$ref": "#/$defs/identifier"},
        "to": {"$ref": "#/$defs/identifier"},
        "status": {"$ref": "#/$defs/status"},
        "provider": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "source_anchor": {
          "anyOf": [{"$ref": "#/$defs/sourceAnchor"}, {"type": "null"}]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"$ref": "#/$defs/coverageStatus"},
        "freshness": {"enum": ["current", "stale", "unknown"]},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "requirement_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "unresolved_reason": {"type": "string", "minLength": 1},
        "next_query": {"type": "string", "minLength": 1},
        "blocked_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "verified"}}},
          "then": {"properties": {"verification_evidence": {"minItems": 1}}}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["observed", "changed", "implemented"]}}},
          "then": {"properties": {"verification_evidence": {"minItems": 1}}}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["observed", "changed", "implemented", "verified"]}}},
          "then": {"properties": {"source_anchor": {"$ref": "#/$defs/sourceAnchor"}}}
        },
        {
          "if": {"required": ["kind"], "properties": {"kind": {"const": "dynamic"}}},
          "then": {"properties": {"status": {"const": "unresolved"}}}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "blocked"}}},
          "then": {"required": ["blocked_reason", "next_query"]}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "unresolved"}}},
          "then": {"required": ["unresolved_reason", "next_query"]}
        }
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "storage_node_id",
        "storage_kind",
        "writers",
        "readers",
        "state_values",
        "state_semantics",
        "state_producers",
        "state_consumers",
        "enum_semantics",
        "enum_producers",
        "enum_consumers",
        "enum_values",
        "schema_enum_values",
        "expected_runtime_state",
        "runtime_evidence",
        "status",
        "verification_evidence",
        "implementation_state"
      ],
      "properties": {
        "contract_id": {"$ref": "#/$defs/identifier"},
        "storage_node_id": {"$ref": "#/$defs/identifier"},
        "storage_kind": {"enum": ["sql_table", "sql_field", "cache", "event", "interface", "file", "other"]},
        "writers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "readers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "writer_milestone": {"type": "string", "minLength": 1},
        "reader_milestone": {"type": "string", "minLength": 1},
        "foreign_key_check": {"type": "string", "minLength": 1},
        "foreign_key_check_result": {"$ref": "#/$defs/evidence"},
        "unique_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "nullable_unique_columns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "null_semantics": {"enum": ["sentinel", "partial_index", "coalesce_expression_index", "blocked"]},
        "null_semantics_blocking_reason": {"type": "string", "minLength": 1},
        "duplicate_query": {"type": "string", "minLength": 1},
        "duplicate_query_result": {"$ref": "#/$defs/evidence"},
        "strategy_name": {"type": "string", "minLength": 1},
        "strategy_status": {"enum": ["ready", "blocked"]},
        "strategy_parameters": {"$ref": "#/$defs/strategyParameters"},
        "strategy_trigger": {"type": "string", "minLength": 1},
        "strategy_target": {"type": "string", "minLength": 1},
        "strategy_entrypoint": {"type": "string", "minLength": 1},
        "strategy_blocking_reason": {"type": "string", "minLength": 1},
        "state_values": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "state_semantics": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "state_producers": {
          "type": "object",
          "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        },
        "state_consumers": {
          "type": "object",
          "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        },
        "state_deferred_milestones": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "terminal_states": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "enum_semantics": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "enum_producers": {
          "type": "object",
          "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        },
        "enum_consumers": {
          "type": "object",
          "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
        },
        "enum_values": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "schema_enum_values": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "expected_runtime_state": {
          "enum": ["non-empty", "intentionally empty", "not applicable"]
        },
        "intentional_empty_reason": {"type": "string", "minLength": 1},
        "intentional_empty_milestone": {"type": "string", "minLength": 1},
        "runtime_evidence": {"$ref": "#/$defs/evidence"},
        "status": {"$ref": "#/$defs/status"},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "failure_mode": {"enum": ["normal", "degraded-with-warning"]},
        "observability_evidence": {"$ref": "#/$defs/evidence"},
        "distinguishes_failure_from_empty": {"type": "boolean"},
        "implementation_state": {"enum": ["unimplemented", "implemented-but-broken", "data-corrupted", "implemented"]},
        "data_audit_evidence": {"$ref": "#/$defs/evidence"},
        "cleanup_plan": {"type": "string", "minLength": 1},
        "blocked_reason": {"type": "string", "minLength": 1},
        "unresolved_reason": {"type": "string", "minLength": 1},
        "next_query": {"type": "string", "minLength": 1}
      },
      "dependentRequired": {
        "strategy_name": ["strategy_status"],
        "strategy_status": ["strategy_name"],
        "strategy_parameters": ["strategy_name"],
        "strategy_trigger": ["strategy_name"],
        "strategy_target": ["strategy_name"],
        "strategy_entrypoint": ["strategy_name"],
        "strategy_blocking_reason": ["strategy_name"]
      },
      "allOf": [
        {
          "anyOf": [
            {"properties": {"writers": {"minItems": 1}}},
            {"required": ["writer_milestone"]}
          ]
        },
        {
          "anyOf": [
            {"properties": {"readers": {"minItems": 1}}},
            {"required": ["reader_milestone"]}
          ]
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "verified"}}},
          "then": {"properties": {"verification_evidence": {"minItems": 1}}}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"enum": ["observed", "changed", "implemented"]}}},
          "then": {"properties": {"verification_evidence": {"minItems": 1}}}
        },
        {
          "if": {"required": ["expected_runtime_state"], "properties": {"expected_runtime_state": {"const": "non-empty"}}},
          "then": {"properties": {"runtime_evidence": {"minItems": 1}}}
        },
        {
          "if": {"required": ["expected_runtime_state"], "properties": {"expected_runtime_state": {"const": "intentionally empty"}}},
          "then": {"required": ["intentional_empty_reason", "intentional_empty_milestone"]}
        },
        {
          "if": {"required": ["storage_kind"], "properties": {"storage_kind": {"const": "sql_table"}}},
          "then": {
            "required": ["foreign_key_check", "foreign_key_check_result"],
            "properties": {"foreign_key_check_result": {"minItems": 1}}
          }
        },
        {
          "if": {"required": ["nullable_unique_columns"], "properties": {"nullable_unique_columns": {"minItems": 1}}},
          "then": {"required": ["null_semantics", "duplicate_query"]}
        },
        {
          "if": {"required": ["strategy_status"], "properties": {"strategy_status": {"const": "ready"}}},
          "then": {"required": ["strategy_parameters", "strategy_trigger", "strategy_target", "strategy_entrypoint"]}
        },
        {
          "if": {"required": ["strategy_status"], "properties": {"strategy_status": {"const": "blocked"}}},
          "then": {"required": ["strategy_blocking_reason"]}
        },
        {
          "if": {"required": ["failure_mode"], "properties": {"failure_mode": {"const": "degraded-with-warning"}}},
          "then": {
            "required": ["observability_evidence", "distinguishes_failure_from_empty"],
            "properties": {
              "observability_evidence": {"minItems": 1},
              "distinguishes_failure_from_empty": {"const": true}
            }
          }
        },
        {
          "if": {"required": ["implementation_state"], "properties": {"implementation_state": {"const": "data-corrupted"}}},
          "then": {
            "required": ["data_audit_evidence", "cleanup_plan"],
            "properties": {"data_audit_evidence": {"minItems": 1}}
          }
        },
        {
          "if": {
            "required": ["status", "implementation_state"],
            "properties": {
              "status": {"enum": ["implemented", "verified"]},
              "implementation_state": {"const": "unimplemented"}
            }
          },
          "then": {
            "properties": {"implementation_state": {"not": {"const": "unimplemented"}}}
          }
        },
        {
          "if": {"properties": {"unique_keys": {"minItems": 1}}, "required": ["unique_keys"]},
          "then": {
            "required": ["duplicate_query", "duplicate_query_result"],
            "properties": {"duplicate_query_result": {"minItems": 1}}
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "blocked"}}},
          "then": {"required": ["blocked_reason", "next_query"]}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "unresolved"}}},
          "then": {"required": ["unresolved_reason", "next_query"]}
        }
      ]
    },
    "testChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "level",
        "status",
        "entrypoint_node_id",
        "test_node_refs",
        "node_refs",
        "edge_refs",
        "requirement_refs",
        "ac_refs",
        "required_roles",
        "error_path_refs",
        "expected_output",
        "command",
        "evidence_kind",
        "static_evidence",
        "runtime_evidence",
        "verification_evidence",
        "uncovered_edge_refs",
        "test_scope"
      ],
      "properties": {
        "chain_id": {"$ref": "#/$defs/identifier"},
        "level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
        "status": {"enum": ["planned", "observed", "implemented", "verified", "blocked", "unresolved", "deferred"]},
        "entrypoint_node_id": {"$ref": "#/$defs/identifier"},
        "test_node_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "node_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "edge_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "requirement_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "ac_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "required_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["producer", "contract", "consumer", "error_path"],
          "properties": {
            "producer": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "contract": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "consumer": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
            "error_path": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}}
          }
        },
        "error_path_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "expected_output": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "evidence_kind": {"enum": ["static", "runtime", "mixed"]},
        "static_evidence": {"$ref": "#/$defs/evidence"},
        "runtime_evidence": {"$ref": "#/$defs/evidence"},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "uncovered_edge_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "test_scope": {"enum": ["targeted", "full", "expanded"]},
        "deferred_reason": {"type": "string", "minLength": 1},
        "deferred_milestone": {"type": "string", "minLength": 1},
        "blocked_reason": {"type": "string", "minLength": 1},
        "unresolved_reason": {"type": "string", "minLength": 1},
        "next_query": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "verified"}}},
          "then": {"properties": {"verification_evidence": {"minItems": 1}}}
        },
        {
          "if": {"required": ["level"], "properties": {"level": {"enum": ["L1", "L2", "L3", "L4"]}}},
          "then": {
            "properties": {
              "required_roles": {
                "properties": {
                  "producer": {"minItems": 1},
                  "contract": {"minItems": 1},
                  "consumer": {"minItems": 1},
                  "error_path": {"minItems": 1}
                }
              },
              "error_path_refs": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "required": ["level", "status"],
            "properties": {"level": {"const": "L0"}, "status": {"const": "verified"}}
          },
          "then": {
            "properties": {
              "evidence_kind": {"const": "static"},
              "static_evidence": {"minItems": 1},
              "runtime_evidence": {"maxItems": 0}
            }
          }
        },
        {
          "if": {
            "required": ["status", "evidence_kind"],
            "properties": {
              "status": {"enum": ["observed", "implemented", "verified"]},
              "evidence_kind": {"const": "static"}
            }
          },
          "then": {"properties": {"static_evidence": {"minItems": 1}}}
        },
        {
          "if": {
            "required": ["status", "evidence_kind"],
            "properties": {
              "status": {"enum": ["observed", "implemented", "verified"]},
              "evidence_kind": {"const": "runtime"}
            }
          },
          "then": {"properties": {"runtime_evidence": {"minItems": 1}}}
        },
        {
          "if": {
            "required": ["status", "evidence_kind"],
            "properties": {
              "status": {"enum": ["observed", "implemented", "verified"]},
              "evidence_kind": {"const": "mixed"}
            }
          },
          "then": {
            "properties": {
              "static_evidence": {"minItems": 1},
              "runtime_evidence": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "required": ["level", "status"],
            "properties": {
              "level": {"enum": ["L1", "L2", "L3", "L4"]},
              "status": {"const": "verified"}
            }
          },
          "then": {
            "properties": {
              "evidence_kind": {"enum": ["runtime", "mixed"]},
              "runtime_evidence": {"minItems": 1}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "deferred"}}},
          "then": {"required": ["deferred_reason", "deferred_milestone"]}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "blocked"}}},
          "then": {"required": ["blocked_reason", "next_query"]}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "unresolved"}}},
          "then": {"required": ["unresolved_reason", "next_query"]}
        }
      ]
    },
    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "evidence"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/identifier"},
        "status": {"enum": ["proposed", "verified", "rejected", "inconclusive"]},
        "evidence": {"$ref": "#/$defs/evidence", "minItems": 1},
        "independent_verification": {"$ref": "#/$defs/evidence"},
        "premises": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "premise_verification": {"$ref": "#/$defs/evidence"},
        "inconclusive_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "verified"}}},
          "then": {
            "required": ["independent_verification"],
            "properties": {"independent_verification": {"minItems": 1}}
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "rejected"}}},
          "then": {
            "required": ["premises", "premise_verification"],
            "properties": {
              "premises": {"minItems": 1},
              "premise_verification": {"minItems": 1}
            }
          }
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "inconclusive"}}},
          "then": {"required": ["inconclusive_reason"]}
        }
      ]
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added_nodes",
        "removed_nodes",
        "changed_nodes",
        "added_edges",
        "removed_edges",
        "changed_edges",
        "added_contracts",
        "removed_contracts",
        "changed_contracts",
        "unresolved",
        "impact",
        "verification_evidence"
      ],
      "properties": {
        "added_nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "removed_nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "changed_nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "added_edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "removed_edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "changed_edges": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "added_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "removed_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "changed_contracts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "unresolved": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "impact": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "verification_evidence": {"$ref": "#/$defs/evidence", "minItems": 1}
      }
    },
    "status": {
      "enum": [
        "planned",
        "observed",
        "changed",
        "implemented",
        "verified",
        "blocked",
        "unresolved"
      ]
    },
    "coverageStatus": {"enum": ["complete", "partial", "unknown"]}
  },
  "allOf": [
    {
      "if": {
        "required": ["graph_type"],
        "properties": {"graph_type": {"const": "change"}}
      },
      "then": {
        "required": ["baseline_sha", "current_sha", "diff"],
        "properties": {
          "artifact_type": {"const": "graph_diff"},
          "diff": {"$ref": "#/$defs/diff"}
        }
      },
      "else": {"properties": {"artifact_type": {"const": "graph_snapshot"}}}
    },
    {
      "if": {
        "required": ["graph_type"],
        "properties": {"graph_type": {"const": "change"}}
      },
      "then": {
        "properties": {
          "diff": {
            "anyOf": [
              {"required": ["added_nodes"], "properties": {"added_nodes": {"minItems": 1}}},
              {"required": ["removed_nodes"], "properties": {"removed_nodes": {"minItems": 1}}},
              {"required": ["changed_nodes"], "properties": {"changed_nodes": {"minItems": 1}}},
              {"required": ["added_edges"], "properties": {"added_edges": {"minItems": 1}}},
              {"required": ["removed_edges"], "properties": {"removed_edges": {"minItems": 1}}},
              {"required": ["changed_edges"], "properties": {"changed_edges": {"minItems": 1}}},
              {"required": ["added_contracts"], "properties": {"added_contracts": {"minItems": 1}}},
              {"required": ["removed_contracts"], "properties": {"removed_contracts": {"minItems": 1}}},
              {"required": ["changed_contracts"], "properties": {"changed_contracts": {"minItems": 1}}}
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["graph_type"],
        "properties": {"graph_type": {"enum": ["observed", "target"]}}
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["baseline_sha"]},
            {"required": ["current_sha"]},
            {"required": ["diff"]}
          ]
        }
      }
    },
    {
      "if": {
        "required": ["graph_type"],
        "properties": {"graph_type": {"const": "target"}}
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "allOf": [
                {
                  "if": {"required": ["status"], "properties": {"status": {"const": "planned"}}},
                  "then": {"properties": {"requirement_refs": {"minItems": 1}}}
                }
              ]
            }
          },
          "edges": {
            "items": {
              "allOf": [
                {
                  "if": {"required": ["status"], "properties": {"status": {"const": "planned"}}},
                  "then": {"properties": {"requirement_refs": {"minItems": 1}}}
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["graph_type"],
        "properties": {"graph_type": {"const": "observed"}}
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {"properties": {"status": {"not": {"enum": ["planned", "changed"]}}}}
          },
          "edges": {
            "items": {"properties": {"status": {"not": {"enum": ["planned", "changed"]}}}}
          },
          "contracts": {
            "items": {"properties": {"status": {"not": {"enum": ["planned", "changed"]}}}}
          },
          "test_chains": {
            "items": {"properties": {"status": {"not": {"const": "planned"}}}}
          }
        }
      }
    },
    {
      "if": {
        "required": ["graph_type"],
        "properties": {"graph_type": {"const": "change"}}
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {"properties": {"status": {"not": {"const": "planned"}}}}
          },
          "edges": {
            "items": {"properties": {"status": {"not": {"const": "planned"}}}}
          },
          "contracts": {
            "items": {"properties": {"status": {"not": {"const": "planned"}}}}
          },
          "test_chains": {
            "items": {"properties": {"status": {"not": {"const": "planned"}}}}
          }
        }
      }
    }
  ]
}
