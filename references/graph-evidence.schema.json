{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/159632zxl/prd-ac-execution-guide/schema/graph-evidence-1.1.json",
  "title": "PRD code graph evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "graph_type",
    "repository",
    "provider",
    "coverage",
    "source_coverage",
    "audit_coverage",
    "nodes",
    "edges",
    "contracts",
    "test_chains"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "artifact_type": {"enum": ["graph_snapshot", "graph_diff"]},
    "graph_type": {"enum": ["observed", "target", "change"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "git_sha"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/gitSha"}
      }
    },
    "provider": {"$ref": "#/$defs/provider"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "paths", "excluded_paths"],
      "properties": {
        "scope": {"enum": ["local", "module", "repository", "system"]},
        "status": {"enum": ["complete", "partial", "unknown"]},
        "paths": {"type": "array", "items": {"type": "string"}},
        "excluded_paths": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "source_coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceCoverage"}
    },
    "audit_coverage": {"$ref": "#/$defs/auditCoverage"},
    "baseline_sha": {"$ref": "#/$defs/gitSha"},
    "current_sha": {"$ref": "#/$defs/gitSha"},
    "diff": {"$ref": "#/$defs/diff"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}},
    "test_chains": {"type": "array", "items": {"$ref": "#/$defs/testChain"}},
    "review_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/reviewFinding"}
    }
  },
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,64}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "command", "generated_at"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "minLength": 1},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_section_id",
        "status",
        "requirement_refs",
        "ears_refs",
        "target_node_refs",
        "target_edge_refs",
        "ac_refs",
        "owner_task",
        "source_anchor"
      ],
      "properties": {
        "source_section_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["covered", "deferred", "not-applicable"]},
        "requirement_refs": {"type": "array", "items": {"type": "string"}},
        "ears_refs": {"type": "array", "items": {"type": "string"}},
        "target_node_refs": {"type": "array", "items": {"type": "string"}},
        "target_edge_refs": {"type": "array", "items": {"type": "string"}},
        "ac_refs": {"type": "array", "items": {"type": "string"}},
        "owner_task": {"type": "string", "minLength": 1},
        "explicit_reason": {"type": "string"},
        "source_anchor": {
          "anyOf": [{"$ref": "#/$defs/sourceAnchor"}, {"type": "null"}]
        }
      }
    },
    "auditCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewers", "independent_verification", "limitations"],
      "properties": {
        "status": {"enum": ["complete", "partial", "inconclusive"]},
        "reviewers": {"type": "array", "items": {"type": "string"}},
        "independent_verification": {"$ref": "#/$defs/evidence"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sourceAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "kind",
        "status",
        "path",
        "qualified_symbol",
        "provider",
        "git_sha",
        "confidence",
        "coverage",
        "freshness",
        "verification_evidence",
        "requirement_refs"
      ],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "path": {"type": "string", "minLength": 1},
        "qualified_symbol": {"type": "string", "minLength": 1},
        "source_anchor": {
          "anyOf": [{"$ref": "#/$defs/sourceAnchor"}, {"type": "null"}]
        },
        "provider": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"$ref": "#/$defs/coverageStatus"},
        "freshness": {"enum": ["current", "stale", "unknown"]},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "requirement_refs": {"type": "array", "items": {"type": "string"}},
        "entrypoint": {"type": "boolean"},
        "test_refs": {"type": "array", "items": {"type": "string"}},
        "test_exemption_reason": {"type": "string", "minLength": 1}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "kind",
        "from",
        "to",
        "status",
        "provider",
        "git_sha",
        "source_anchor",
        "confidence",
        "coverage",
        "freshness",
        "verification_evidence",
        "requirement_refs"
      ],
      "properties": {
        "edge_id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "calls",
            "imports",
            "reads",
            "writes",
            "publishes",
            "subscribes",
            "validates",
            "routes",
            "returns",
            "dynamic"
          ]
        },
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "status": {"$ref": "#/$defs/status"},
        "provider": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/gitSha"},
        "source_anchor": {
          "anyOf": [{"$ref": "#/$defs/sourceAnchor"}, {"type": "null"}]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "coverage": {"$ref": "#/$defs/coverageStatus"},
        "freshness": {"enum": ["current", "stale", "unknown"]},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "requirement_refs": {"type": "array", "items": {"type": "string"}},
        "unresolved_reason": {"type": "string"},
        "next_query": {"type": "string"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "storage_node_id",
        "writers",
        "readers",
        "state_values",
        "state_semantics",
        "state_producers",
        "state_consumers",
        "enum_semantics",
        "enum_producers",
        "enum_consumers",
        "enum_values",
        "schema_enum_values",
        "expected_runtime_state",
        "runtime_evidence",
        "status",
        "verification_evidence",
        "implementation_state"
      ],
      "properties": {
        "contract_id": {"type": "string", "minLength": 1},
        "storage_node_id": {"type": "string", "minLength": 1},
        "storage_kind": {"enum": ["sql_table", "sql_field", "cache", "event", "interface", "file", "other"]},
        "writers": {"type": "array", "items": {"type": "string"}},
        "readers": {"type": "array", "items": {"type": "string"}},
        "writer_milestone": {"type": "string"},
        "reader_milestone": {"type": "string"},
        "foreign_key_check": {"type": "string"},
        "unique_keys": {"type": "array", "items": {"type": "string"}},
        "nullable_unique_columns": {"type": "array", "items": {"type": "string"}},
        "null_semantics": {"enum": ["sentinel", "partial_index", "coalesce_expression_index", "blocked"]},
        "null_semantics_blocking_reason": {"type": "string"},
        "duplicate_query": {"type": "string"},
        "strategy_name": {"type": "string"},
        "strategy_status": {"enum": ["ready", "blocked"]},
        "strategy_parameters": {"type": ["object", "array", "string", "number"]},
        "strategy_trigger": {"type": "string"},
        "strategy_target": {"type": "string"},
        "strategy_entrypoint": {"type": "string"},
        "strategy_blocking_reason": {"type": "string"},
        "state_values": {"type": "array", "items": {"type": "string"}},
        "state_semantics": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "state_producers": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "state_consumers": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "state_deferred_milestones": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "terminal_states": {"type": "array", "items": {"type": "string"}},
        "enum_semantics": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "enum_producers": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "enum_consumers": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}}
        },
        "enum_values": {"type": "array", "items": {"type": "string"}},
        "schema_enum_values": {"type": "array", "items": {"type": "string"}},
        "expected_runtime_state": {
          "enum": ["non-empty", "intentionally empty", "not applicable"]
        },
        "intentional_empty_reason": {"type": "string"},
        "intentional_empty_milestone": {"type": "string"},
        "runtime_evidence": {"$ref": "#/$defs/evidence"},
        "status": {"$ref": "#/$defs/status"},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "failure_mode": {"enum": ["normal", "degraded-with-warning"]},
        "observability_evidence": {"$ref": "#/$defs/evidence"},
        "distinguishes_failure_from_empty": {"type": "boolean"},
        "implementation_state": {"enum": ["unimplemented", "implemented-but-broken", "data-corrupted", "implemented"]},
        "data_audit_evidence": {"$ref": "#/$defs/evidence"},
        "cleanup_plan": {"type": "string"}
      }
    },
    "testChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "level",
        "status",
        "entrypoint_node_id",
        "test_node_refs",
        "node_refs",
        "edge_refs",
        "requirement_refs",
        "ac_refs",
        "required_roles",
        "error_path_refs",
        "expected_output",
        "command",
        "evidence_kind",
        "static_evidence",
        "runtime_evidence",
        "verification_evidence",
        "uncovered_edge_refs",
        "test_scope"
      ],
      "properties": {
        "chain_id": {"type": "string", "minLength": 1},
        "level": {"enum": ["L0", "L1", "L2", "L3", "L4"]},
        "status": {"enum": ["planned", "implemented", "verified", "blocked", "unresolved", "deferred"]},
        "entrypoint_node_id": {"type": "string", "minLength": 1},
        "test_node_refs": {"type": "array", "items": {"type": "string"}},
        "node_refs": {"type": "array", "items": {"type": "string"}},
        "edge_refs": {"type": "array", "items": {"type": "string"}},
        "requirement_refs": {"type": "array", "items": {"type": "string"}},
        "ac_refs": {"type": "array", "items": {"type": "string"}},
        "required_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["producer", "contract", "consumer", "error_path"],
          "properties": {
            "producer": {"type": "array", "items": {"type": "string"}},
            "contract": {"type": "array", "items": {"type": "string"}},
            "consumer": {"type": "array", "items": {"type": "string"}},
            "error_path": {"type": "array", "items": {"type": "string"}}
          }
        },
        "error_path_refs": {"type": "array", "items": {"type": "string"}},
        "expected_output": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "evidence_kind": {"enum": ["static", "runtime", "mixed"]},
        "static_evidence": {"$ref": "#/$defs/evidence"},
        "runtime_evidence": {"$ref": "#/$defs/evidence"},
        "verification_evidence": {"$ref": "#/$defs/evidence"},
        "uncovered_edge_refs": {"type": "array", "items": {"type": "string"}},
        "test_scope": {"enum": ["targeted", "full", "expanded"]},
        "deferred_reason": {"type": "string", "minLength": 1},
        "deferred_milestone": {"type": "string", "minLength": 1},
        "blocked_reason": {"type": "string", "minLength": 1},
        "next_query": {"type": "string", "minLength": 1}
      }
    },
    "reviewFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "status", "evidence"],
      "properties": {
        "finding_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "verified", "rejected", "inconclusive"]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "independent_verification": {"$ref": "#/$defs/evidence"},
        "premises": {"type": "array", "items": {"type": "string"}},
        "premise_verification": {"$ref": "#/$defs/evidence"},
        "inconclusive_reason": {"type": "string", "minLength": 1}
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added_nodes",
        "removed_nodes",
        "changed_nodes",
        "added_edges",
        "removed_edges",
        "changed_edges",
        "unresolved",
        "impact",
        "verification_evidence"
      ],
      "properties": {
        "added_nodes": {"type": "array", "items": {"type": "string"}},
        "removed_nodes": {"type": "array", "items": {"type": "string"}},
        "changed_nodes": {"type": "array", "items": {"type": "string"}},
        "added_edges": {"type": "array", "items": {"type": "string"}},
        "removed_edges": {"type": "array", "items": {"type": "string"}},
        "changed_edges": {"type": "array", "items": {"type": "string"}},
        "unresolved": {"type": "array", "items": {"type": "string"}},
        "impact": {"type": "array", "items": {"type": "string"}},
        "verification_evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "status": {
      "enum": [
        "planned",
        "observed",
        "changed",
        "implemented",
        "verified",
        "blocked",
        "unresolved",
        "removed"
      ]
    },
    "coverageStatus": {"enum": ["complete", "partial", "unknown"]}
  },
  "allOf": [
    {
      "if": {
        "required": ["graph_type"],
        "properties": {"graph_type": {"const": "change"}}
      },
      "then": {
        "required": ["baseline_sha", "current_sha", "diff"],
        "properties": {
          "artifact_type": {"const": "graph_diff"},
          "diff": {"$ref": "#/$defs/diff"}
        }
      },
      "else": {"properties": {"artifact_type": {"const": "graph_snapshot"}}}
    }
  ]
}
